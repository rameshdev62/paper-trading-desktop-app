# Learning/paper-testing use only. Yahoo Finance data is not an execution-grade feed.
PAPER_MODE=true
TIMEFRAME=15m
LOOKBACK_BREAKOUT=12
LOOKBACK_VOLUME=20
VOLUME_MULTIPLIER=1.2

INITIAL_CAPITAL_INR=100000
RISK_PER_TRADE_INR=100
MAX_POSITION_VALUE_INR=10000
MAX_OPEN_POSITIONS=3
MAX_SHARES_PER_STOCK=500

STOP_LOSS_PCT=1.0
TARGET_PCT=2.0
TRAILING_STOP_PCT=0.75

# Use a conservative delay after candle end before considering it closed.
CANDLE_CLOSE_BUFFER_SECONDS=60
POLL_SECONDS=90
LOG_LEVEL=INFO
